# Google Apps Script URL, shared by the RSVP form and guest recommendations.
# Get this by deploying the Apps Script in your Google Sheet (source: apps-script/Code.gs).
# Used for the RSVP POST, the name-lookup GET (duplicate check + invite allow-list),
# and the recommendations list/post/reply actions.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
